---
// Self-hosted fonts, Latin + Latin Extended only (Czech diacritics); no Google Fonts (CSP, consent).
import '@fontsource/bricolage-grotesque/latin-600.css';
import '@fontsource/bricolage-grotesque/latin-ext-600.css';
import '@fontsource/bricolage-grotesque/latin-800.css';
import '@fontsource/bricolage-grotesque/latin-ext-800.css';
import '@fontsource-variable/figtree/wght.css';
// Preload the faces the hero needs first (H1/tickers: Bricolage 800 latin + latin-ext for č/ř/ž;
// text: Figtree latin). `?url` resolves to the same content-hashed /_astro/ file the @font-face
// rules above point at, so the preload is reused instead of fetched twice (tests/build/font-preload).
import bricolage800Latin from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-800-normal.woff2?url';
import bricolage800LatinExt from '@fontsource/bricolage-grotesque/files/bricolage-grotesque-latin-ext-800-normal.woff2?url';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/global.scss';
import ConsentBanner from '../components/ConsentBanner';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  /** Site header with the logo (default on). */
  header?: boolean;
}

const { title, description, noindex = false, ogImage, header = true } = Astro.props;
const isHome = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage ?? '/og.png', Astro.site);
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[bricolage800Latin, bricolage800LatinExt, figtreeLatin].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical.href} />}
    <meta name="theme-color" content="#0F2257" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="ETF Dvojče" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={og.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="facebook-domain-verification" content="11mkxrmxrwna1as6mkdh6ogh4hq5ik" />
    <slot name="head" />
  </head>
  <body>
    {header && (
      <header class="masthead">
        <Logo href={isHome ? undefined : '/'} />
      </header>
    )}
    <slot />
    <ConsentBanner client:only="react" />
    <script>
      import { initAnalytics } from '../lib/track';
      const start = () => initAnalytics();
      if ('requestIdleCallback' in window) requestIdleCallback(start); else setTimeout(start, 1);
    </script>
  </body>
</html>
