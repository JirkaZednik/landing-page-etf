---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StickyCta from '../components/StickyCta';
import FundPicker from '../components/FundPicker';
import FeeCalculator from '../components/FeeCalculator';
---
<Base
  title="Indexák – evropská dvojčata amerických ETF"
  description="Které evropské ETF sledují stejný index jako VOO, SPY a IVV a kolik stojí."
>
  <script is:inline slot="head">
    // keep in sync with heroVariantFromUtm in src/lib/copy.ts
    // Runs before first paint, so the hero variant switch causes no layout shift.
    (function () {
      var c = new URLSearchParams(location.search).get('utm_content') || '';
      document.documentElement.dataset.variant = c.charAt(0) === 'b' ? 'b' : 'a';
    })();
  </script>
  <header class="masthead"><span class="masthead__brand">Indexák</span></header>
  <main>
    <Hero variant="a" />
    <section id="fondy" data-section="fondy" class="section"><h2>Další fondy z NYSE</h2><FundPicker client:visible /></section>
    <section id="kalkulacka" data-section="kalkulacka" class="section"><h2>Kolik stojí poplatky</h2><FeeCalculator client:visible /></section>
  </main>
  <StickyCta client:idle />
</Base>
