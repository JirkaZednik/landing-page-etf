---
import Base from '../layouts/Base.astro';
import BrokerPicker from '../components/BrokerPicker';
import PhoneOffer from '../components/PhoneOffer';
---
<Base title="Návod ke stažení | ETF Dvojče" description="Váš návod ke koupi evropských dvojčat ETF." noindex>
  <header class="masthead"><a href="/" class="masthead__brand thanks__home">ETF Dvojče</a></header>
  <main class="thanks">
    <h1>Hotovo. Návod je váš.</h1>
    <a href="/navod-etf.pdf" download data-pdf class="thanks__pdf">Stáhnout návod (PDF)</a>
    <p class="thanks__muted">Stejný návod jsme vám poslali i e-mailem.</p>
    <hr class="thanks__rule" />
    <BrokerPicker client:load />
    <hr class="thanks__rule" />
    <PhoneOffer client:visible page="dekujeme" />
  </main>
</Base>

<script>
  import { track } from '../lib/track';
  track('thankyou_viewed');
  document.querySelector('[data-pdf]')?.addEventListener('click', () => track('pdf_downloaded'));
</script>
